# Google Gemini API key (https://aistudio.google.com/apikey)
# Supports both formats:
#   - AQ.xxxx  (new authorization keys from AI Studio, recommended)
#   - AIzaxxxx (legacy API keys)
GEMINI_API_KEY=

# Optional: override the default model (gemini-2.5-flash-lite)
# Deprecated models like gemini-2.0-flash-lite return limit: 0 on free tier.
# GEMINI_MODEL=gemini-2.5-flash-lite

# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
