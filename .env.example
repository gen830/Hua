# Google Gemini API key (https://aistudio.google.com/apikey)
# Supports both formats:
#   - AQ.xxxx  (new authorization keys from AI Studio, recommended)
#   - AIzaxxxx (legacy API keys)
GEMINI_API_KEY=

# Optional: override the default model (gemini-2.5-flash-lite)
# Deprecated models like gemini-2.0-flash-lite return limit: 0 on free tier.
# GEMINI_MODEL=gemini-2.5-flash-lite

# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: canonical site URL for OAuth redirect (production Vercel URL).
# Local dev uses window.location.origin automatically.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# --- Google login setup (Supabase Dashboard) ---
# 1. Authentication → Providers → Google → enable, add Client ID & Secret
#    (Google Cloud Console → OAuth 2.0 Client → Web application)
# 2. Authentication → URL Configuration:
#    Redirect URLs must include:
#      http://localhost:3000/auth/callback
#      https://your-app.vercel.app/auth/callback
# 3. SQL Editor: run supabase/saved_words.sql, saved_sentences.sql (if new),
#    then supabase/auth_rls.sql to lock rows to the signed-in Google email.
